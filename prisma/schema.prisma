// CafeFlow Web Platform — Prisma schema
// Mirrors the Supabase PostgreSQL schema in /supabase/migrations (see that folder
// for the production DDL with native enums, partial indexes and RLS policies).
//
// Entity model:
//   Profile (user, role SUPER_ADMIN|CLIENT) ──> Client ──> Restaurant ──> License
//                                                    │                ──> Devices
//                                                    ├──> Sales            (idempotent sync)
//                                                    └──> Orders ──> OrderItems
//   SyncLog records every POS synchronization batch.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── AUTH / USERS ───────────────────────────────

model Profile {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  fullName     String
  phone        String?
  // SUPER_ADMIN | CLIENT (validated with Zod at the service layer)
  role         String   @default("CLIENT")
  // Links the login account to its client business account (CLIENT role only)
  clientId     String?  @unique
  client       Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  isActive     Boolean  @default(true)
  // Bumped on every password change/reset — JWTs issued before the bump
  // stop working, so stolen session cookies die with the old password.
  tokenVersion Int      @default(0)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  resetTokens PasswordResetToken[]
  supportGrants SupportGrant[]
  auditLogs     AuditLog[]

  @@index([role])
  @@index([clientId])
  @@map("profiles")
}

// Password reset tokens (forgot-password / reset-password flow)
model PasswordResetToken {
  id        String   @id @default(uuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([profileId])
  @@map("password_reset_tokens")
}

// ─────────────────────────────── CLIENTS ───────────────────────────────

model Client {
  id         String        @id @default(uuid())
  // Primary contact person
  name       String
  email      String        @unique
  phone      String?
  companyName String
  // ACTIVE | SUSPENDED | DEACTIVATED
  status     String        @default("ACTIVE")
  notes      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  profiles     Profile[]
  restaurants  Restaurant[]
  supportGrants SupportGrant[]

  @@index([status])
  @@map("clients")
}

// ─────────────────────────────── RESTAURANTS ───────────────────────────────

model Restaurant {
  id         String   @id @default(uuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name       String
  address    String?
  city       String?
  phone      String?
  // ACTIVE | SUSPENDED | DEACTIVATED
  status     String   @default("ACTIVE")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  licenses License[]
  devices  Device[]
  sales    Sale[]
  orders   Order[]
  shifts   Shift[]
  expenses Expense[]
  syncLogs SyncLog[]

  @@index([clientId])
  @@index([status])
  @@map("restaurants")
}

// ─────────────────────────────── LICENSES ───────────────────────────────
// One active license per restaurant. REVOKED licenses are kept for audit
// history and free the restaurant for a new license (enforced at app level
// in SQLite; partial unique index in the PostgreSQL migration).

model License {
  id             String    @id @default(uuid())
  restaurantId   String
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  licenseKey     String    @unique
  // PENDING | ACTIVE | EXPIRED | SUSPENDED | REVOKED
  status         String    @default("PENDING")
  maxDevices     Int       @default(1)
  activatedAt    DateTime?
  expiresAt      DateTime
  lastVerifiedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  devices Device[]

  @@index([restaurantId])
  @@index([status])
  @@index([licenseKey])
  @@index([expiresAt])
  @@map("licenses")
}

// ─────────────────────────────── DEVICES ───────────────────────────────
// A POS installation. deviceIdentifier is the machine identifier reported
// by the Tauri app (hostname + machine-id). Tokens are stored hashed —
// the raw token only exists in the POS.

model Device {
  id              String    @id @default(uuid())
  restaurantId    String
  restaurant      Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  licenseId       String
  license         License    @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  deviceIdentifier String
  deviceName      String?
  osInfo          String?
  appVersion      String?
  deviceTokenHash String    @unique
  // PENDING | ACTIVE | BLOCKED | DEACTIVATED
  status          String    @default("ACTIVE")
  activatedAt     DateTime  @default(now())
  lastSeenAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sales    Sale[]
  orders   Order[]
  shifts   Shift[]
  expenses Expense[]

  @@unique([restaurantId, deviceIdentifier])
  @@index([restaurantId])
  @@index([licenseId])
  @@index([status])
  @@map("devices")
}

// ─────────────────────────────── SALES (POS SYNC) ───────────────────────────────
// Financial transactions synced from the desktop POS.
// (restaurant_id, local_sale_id) is UNIQUE → idempotent sync.

model Sale {
  id            String   @id @default(uuid())
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  // POS terminal that uploaded the record (stamped server-side from the device
  // token at sync time; null for records synced before this column existed)
  deviceId      String?
  device        Device?  @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  localSaleId   String
  saleNumber    String?
  saleDate      DateTime
  subtotal      Float    @default(0)
  discount      Float    @default(0)
  tax           Float    @default(0)
  total         Float
  // CASH | CARD | MOBILE | OTHER
  paymentMethod String?
  // COMPLETED | REFUNDED | CANCELLED
  status        String   @default("COMPLETED")
  customerCount Int?
  syncedAt      DateTime @default(now())
  createdAt     DateTime @default(now())

  @@unique([restaurantId, localSaleId])
  @@index([restaurantId, saleDate])
  @@index([saleDate])
  @@index([status])
  @@index([deviceId])
  @@map("sales")
}

// ─────────────────────────────── ORDERS (POS SYNC) ───────────────────────────────
// Detailed order records with line items.
// (restaurant_id, local_order_id) is UNIQUE → idempotent sync.

model Order {
  id            String   @id @default(uuid())
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  // POS terminal that uploaded the record (stamped server-side at sync time)
  deviceId      String?
  device        Device?  @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  localOrderId  String
  orderNumber   String
  orderDate     DateTime
  subtotal      Float    @default(0)
  discount      Float    @default(0)
  tax           Float    @default(0)
  total         Float
  // CASH | CARD | MOBILE | OTHER
  paymentMethod String?
  // PENDING | COMPLETED | REFUNDED | CANCELLED
  status        String   @default("COMPLETED")
  customerCount Int?
  syncedAt      DateTime @default(now())
  createdAt     DateTime @default(now())

  items OrderItem[]

  @@unique([restaurantId, localOrderId])
  @@index([restaurantId, orderDate])
  @@index([orderDate])
  @@index([status])
  @@index([deviceId])
  @@map("orders")
}

model OrderItem {
  id          String  @id @default(uuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  localItemId String?
  name        String
  quantity    Int
  unitPrice   Float
  total       Float
  // category reported by POS for nicer grouping (optional)
  category    String?

  @@index([orderId])
  @@map("order_items")
}

// ─────────────────────────────── SHIFTS (POS SYNC) ───────────────────────────────
// Closed-shift cash reconciliation uploaded by the POS.
// (restaurant_id, local_shift_id) is UNIQUE → idempotent sync.

model Shift {
  id             String     @id @default(uuid())
  restaurantId   String
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  // POS terminal that uploaded the record (stamped server-side at sync time)
  deviceId       String?
  device         Device?    @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  localShiftId   String
  shiftNumber    Int?
  openedAt       DateTime
  closedAt       DateTime
  cashierName    String?
  openingCash    Float?
  closingCash    Float?
  expectedCash   Float?
  cashDifference Float?
  orderCount     Int?
  grossSales     Float?
  refundsTotal   Float?
  expensesTotal  Float?
  netSales       Float?
  syncedAt       DateTime   @default(now())
  createdAt      DateTime   @default(now())

  @@unique([restaurantId, localShiftId])
  @@index([restaurantId, openedAt])
  @@index([openedAt])
  @@index([deviceId])
  @@map("shifts")
}

// ─────────────────────────────── EXPENSES (POS SYNC) ───────────────────────────────
// Cash expenses recorded on the POS; they reduce expected cash per shift.
// (restaurant_id, local_expense_id) is UNIQUE → idempotent sync.

model Expense {
  id             String     @id @default(uuid())
  restaurantId   String
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  // POS terminal that uploaded the record (stamped server-side at sync time)
  deviceId       String?
  device         Device?    @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  localExpenseId String
  date           DateTime
  category       String?
  description    String?
  amount         Float
  cashierName    String?
  shiftLocalId   String?
  syncedAt       DateTime   @default(now())
  createdAt      DateTime   @default(now())

  @@unique([restaurantId, localExpenseId])
  @@index([restaurantId, date])
  @@index([date])
  @@index([deviceId])
  @@map("expenses")
}

// ─────────────────────────────── SYNC LOGS ───────────────────────────────

model SyncLog {
  id              String   @id @default(uuid())
  restaurantId    String
  restaurant      Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  deviceId        String?
  // SALES | ORDERS | SHIFTS | EXPENSES
  recordType      String
  recordsReceived Int      @default(0)
  recordsCreated  Int      @default(0)
  recordsSkipped  Int      @default(0)
  recordsFailed   Int      @default(0)
  // SUCCESS | PARTIAL | FAILED
  status          String
  message         String?
  createdAt       DateTime @default(now())

  @@index([restaurantId])
  @@index([createdAt])
  @@map("sync_logs")
}

// ─────────────────────── SUPPORT ACCESS (break-glass) ───────────────────────
// Super Admins cannot browse client business data (orders, sales detail) by
// default. To help a specific client they must create a time-boxed grant with
// a written reason; every detail view made under a grant is written to
// AuditLog. Grants auto-expire and can be revoked.

model SupportGrant {
  id             String    @id @default(uuid())
  adminProfileId String
  adminProfile   Profile   @relation(fields: [adminProfileId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  reason         String
  createdAt      DateTime  @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?

  @@index([adminProfileId, clientId])
  @@index([clientId])
  @@map("support_grants")
}

// ─────────────────────── AUDIT LOG ───────────────────────
// Append-only trail for sensitive actions: support-grant lifecycle and every
// order/sales detail view made under an active grant.

model AuditLog {
  id             String   @id @default(uuid())
  actorProfileId String?
  actorProfile   Profile? @relation(fields: [actorProfileId], references: [id], onDelete: SetNull)
  // Denormalized so the trail survives profile deletion
  actorEmail     String
  // e.g. SUPPORT_GRANT_CREATE, SUPPORT_GRANT_REVOKE, VIEW_ORDERS, VIEW_ORDER_DETAIL, VIEW_SALES
  action         String
  targetType     String?
  targetId       String?
  clientId       String?
  metadata       String?
  createdAt      DateTime @default(now())

  @@index([actorProfileId])
  @@index([clientId])
  @@index([createdAt])
  @@map("audit_logs")
}
